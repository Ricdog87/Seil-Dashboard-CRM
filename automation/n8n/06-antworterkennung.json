      "name": "Ungelesene Mails aus deals@ (Graph)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -280,
        700
      ],
      "credentials": {
        "oAuth2Api": {
          "id": "seil-graph",
          "name": "Microsoft Graph (SEIL)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Graph liefert { value: [ ...Nachrichten ] }. Eine Nachricht je Item, Felder so, wie der\n// Klassifizierer sie erwartet (subject, from als Adresse, textPlain, messageId).\nconst antwort = $input.first().json;\nconst liste = Array.isArray(antwort.value) ? antwort.value : [];\nif (antwort.error) throw new Error('Graph-Fehler beim Lesen von deals@: ' + JSON.stringify(antwort.error));\nconst ohneHtml = (h) => String(h ?? '').replace(/<style[\\s\\S]*?<\\/style>/gi, '').replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ').replace(/\\s+/g, ' ').trim();\nreturn liste.map((m) => {\n  const istText = (m.body?.contentType ?? '').toLowerCase() === 'text';\n  const textPlain = istText ? (m.body?.content ?? '') : ohneHtml(m.body?.content ?? m.bodyPreview);\n  return { json: {\n    messageId: m.id, internetMessageId: m.internetMessageId ?? null, conversationId: m.conversationId ?? null,\n    subject: m.subject ?? '', from: m.from?.emailAddress?.address ?? '', fromName: m.from?.emailAddress?.name ?? '',\n    textPlain, text: textPlain, receivedDateTime: m.receivedDateTime ?? null,\n  } };\n});"
      },
