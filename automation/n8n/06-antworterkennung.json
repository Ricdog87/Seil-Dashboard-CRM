    {
      "id": "code-20",
      "name": "Datenraum-Abgleich: Unterlage vorhanden?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1170,
        840
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Antwort von WF 09 (Modul-01-Stand) gegen die angefragten Unterlagen halten – Heuristik,\n// produktiv übernimmt der LLM-Node die Zuordnung. Läuft je Item, behält den Mail-Kontext.\nconst mail = $('Klassifizieren (Trigger-Wörter)').item.json;\nconst antwort = $input.item.json;\nconst objekt = (antwort.objekte ?? [])[0];\nconst text = `${mail.subject ?? ''} ${mail.textPlain ?? mail.text ?? ''}`.toLowerCase();\nconst WOERTER = ['mieterliste', 'mietaufstellung', 'grundriss', 'grundbuch', 'exposé', 'expose', 'energieausweis',\n  'flächenaufstellung', 'flaechenaufstellung', 'teilungserklärung', 'baugenehmigung', 'altlasten'];\nconst gewuenscht = WOERTER.filter((w) => text.includes(w));\nlet unterlageStatus = 'unklar';\nif (objekt && Array.isArray(objekt.dokumente)) {\n  const treffer = objekt.dokumente.filter((d) => gewuenscht.some((w) => String(d.name ?? '').toLowerCase().includes(w.replace('ä', 'ae'))\n    || String(d.name ?? '').toLowerCase().includes(w)));\n  if (gewuenscht.length && treffer.length && treffer.every((d) => d.status === 'vorhanden')) unterlageStatus = 'vorhanden';\n  else if (gewuenscht.length) unterlageStatus = 'nicht_im_datenraum';\n}\nreturn { json: { ...mail, unterlageStatus, gewuenschteUnterlagen: gewuenscht, datenraumStand: objekt?.stand ?? null } };"
      }
    },
