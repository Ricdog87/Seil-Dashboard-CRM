    {
      "id": "code-06",
      "name": "Klassifizieren (Trigger-Wörter)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 620],
      "parameters": {
        "jsCode": "// Fallback-Heuristik – produktiv sitzt davor eine LLM-Klassifikation (Claude).\n// Kategorien = Entscheidungsbaum aus dem Standardprozess Investorenkommunikation.\nconst m = $input.first().json;\nconst text = `${m.subject ?? ''} ${m.textPlain ?? m.text ?? ''}`.toLowerCase();\nconst hat = (woerter) => woerter.some((w) => text.includes(w));\nlet art = 'sonstiges';\nif (hat(['kein interesse', 'absage', 'nicht weiter', 'sehen wir ab', 'passt nicht'])) art = 'absage';\nelse if (hat(['unsere kriterien', 'unser ankaufsprofil', 'wir suchen aktuell', 'suchprofil'])) art = 'kriterien';\nelse if (hat(['besichtigung', 'vor ort', 'objektbesichtigung', 'terminvorschlag'])) art = 'besichtigung';\nelse if (hat(['preis', 'kaufpreisvorstellung', 'faktor', 'indikation'])) art = 'preisanfrage';\nelse if (hat(['unterlagen', 'exposé', 'expose', 'datenraum', 'mietaufstellung', 'grundriss'])) art = 'unterlagen';\nelse if (hat(['rückruf', 'telefonat', 'anrufen', 'telefonisch'])) art = 'telefonat';\nelse if (hat(['interesse', 'ansprechpartner', 'mehr informationen'])) art = 'interesse';\nconst profilUpdate = hat(['region', 'regionen', 'standort', 'zielregion', 'suchen wir', 'ankaufsprofil']);\nreturn [{ json: { ...m, art, profilUpdate } }];"
      }
    },
