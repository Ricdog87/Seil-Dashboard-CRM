    {
      "id": "code-06",
      "name": "Klassifizieren (Trigger-Wörter)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        700
      ],
      "parameters": {
        "jsCode": "// Fallback-Heuristik – produktiv sitzt davor eine LLM-Klassifikation (Claude).\n// Kategorien = Entscheidungsbaum aus dem Standardprozess. Verarbeitet ALLE eingegangenen Mails.\nreturn $input.all().map(({ json: m }) => {\n  const text = `${m.subject ?? ''} ${m.textPlain ?? m.text ?? ''}`.toLowerCase();\n  const hat = (woerter) => woerter.some((w) => text.includes(w));\n  let art = 'sonstiges';\n  if (hat(['kein interesse', 'absage', 'nicht weiter', 'sehen wir ab', 'passt nicht'])) art = 'absage';\n  else if (hat(['unsere kriterien', 'unser ankaufsprofil', 'wir suchen aktuell', 'suchprofil'])) art = 'kriterien';\n  else if (hat(['besichtigung', 'vor ort', 'objektbesichtigung', 'terminvorschlag'])) art = 'besichtigung';\n  else if (hat(['preis', 'kaufpreisvorstellung', 'faktor', 'indikation'])) art = 'preisanfrage';\n  else if (hat(['unterlagen', 'exposé', 'expose', 'datenraum', 'mietaufstellung', 'grundriss'])) art = 'unterlagen';\n  else if (hat(['rückruf', 'telefonat', 'anrufen', 'telefonisch'])) art = 'telefonat';\n  else if (hat(['interesse', 'ansprechpartner', 'mehr informationen'])) art = 'interesse';\n  const profilUpdate = hat(['region', 'regionen', 'standort', 'zielregion', 'suchen wir', 'ankaufsprofil']);\n  // preisanfragen: Zähler bisheriger schriftlicher Preisanfragen dieses Kontakts (aus der Ablage), Platzhalter 0\n  return { json: { ...m, art, profilUpdate, preisanfragen: m.preisanfragen ?? 0, kontaktId: m.kontaktId ?? m.from ?? '', email: m.from ?? '' } };\n});"
      }
    },
