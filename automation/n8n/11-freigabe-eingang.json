    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "id": "fe-if-gefunden",
              "leftValue": "={{ $json.entwurf_id ? 'ja' : 'nein' }}",
              "rightValue": "ja",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "fe-if-gefunden-0001",
      "name": "Offener Eintrag getroffen?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        900,
        240
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, entwurfId: $('Entscheidung lesen').first().json.entwurfId, grund: 'Kein offener Eintrag mit dieser Entwurfs-ID - schon entschieden oder unbekannt. Es wurde nichts versendet.' }) }}",
        "options": {
          "responseCode": 409
        }
      },
      "id": "fe-resp-nicht-offen-0001",
      "name": "Nicht offen melden",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
