        "options": {
          "responseCode": 502
        }
      },
      "id": "fe-resp-stoerung-0001",
      "name": "Stoerung melden",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1340,
