      "id": "kt-lesen",
      "name": "Kontaktstand lesen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Kontaktstaende eines Mandats fuers Cockpit aufbereiten.\n// Volle Antwort von PostgREST: ein leeres Mandat ist ein leeres Array mit 200,\n// eine Stoerung ist alles andere. Das Cockpit zeigt sonst \"niemand im\n// Verteiler\", obwohl die Leitung gestoert ist.\nconst r = $input.first()?.json ?? {};\nconst status = Number(r.statusCode ?? 0);\nconst zeilen = r.body;\nif (!(status >= 200 && status < 300) || !Array.isArray(zeilen)) {\n  return [{ json: { stoerung: true, stand: new Date().toISOString(),\n                    grund: 'Kontaktstand nicht lesbar (HTTP ' + (status || 'ohne Antwort') + ')' } }];\n}\nconst kontakte = zeilen.filter((z) => z && z.investor_id).map((z) => ({\n  investorId: z.investor_id,\n  mandat: z.mandat,\n  firma: z.firma ?? null,\n  ansprechpartner: z.ansprechpartner ?? null,\n  email: z.email ?? null,\n  status: z.status ?? 'vorgemerkt',\n  notiz: z.notiz ?? null,\n  letzterKontakt: z.letzter_kontakt ?? null,\n  naechstesFollowUp: z.naechstes_followup ?? null,\n  geaendertDurch: z.geaendert_durch ?? null,\n  geaendert: z.geaendert ?? null,\n}));\nreturn [{ json: { stand: new Date().toISOString(), anzahl: kontakte.length, kontakte } }];\n"
      },
      "id": "kt-mappen",
      "name": "Antwort fuers Cockpit bauen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "id": "kt-if-lesbar",
              "leftValue": "={{ $json.stoerung ? 'ja' : 'nein' }}",
              "rightValue": "nein",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "kt-lesbar",
      "name": "Lesbar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "allIncomingItems",
        "options": {}
