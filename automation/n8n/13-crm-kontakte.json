      ]
    },
    {
      "parameters": {
        "url": "={{ $json.supabaseBasis }}/rest/v1/{{ $json.tabelle }}?mandat=eq.{{ encodeURIComponent($('Kontaktstand abrufen').first().json.query?.mandat ?? '') }}&order=firma.asc&limit=500",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json",
