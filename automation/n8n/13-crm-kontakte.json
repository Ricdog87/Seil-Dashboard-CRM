    {
      "parameters": {
        "httpMethod": "POST",
        "path": "seil/kontakt",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "kt-webhook-schreiben",
      "name": "Kontaktstand setzen",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        260,
        280
      ],
      "webhookId": "seil-kontakt-setzen"
    },
    {
      "parameters": {
        "jsCode": "// Einen oder viele Kontaktstaende setzen. Das Cockpit schickt beim Versand die\n// ganze Empfaengerliste auf einmal, beim Haendischen einen einzelnen Eintrag.\n// Nur bekannte Stufen werden durchgelassen - eine falsche Stufe faengt sonst\n// erst die Datenbank, und dann steht im Cockpit ein Fehler ohne Erklaerung.\nconst STUFEN = ['vorgemerkt','angeschrieben','nda_angefragt','nda_unterzeichnet',\n                'datenraum_freigegeben','interesse','preisanfrage','abgesagt'];\nconst b = $input.first().json.body ?? $input.first().json;\nconst mandat = String(b.mandat ?? '').trim();\nif (!mandat) throw new Error('Kontaktstand ohne Mandat');\nconst roh = Array.isArray(b.kontakte) ? b.kontakte : [b];\nconst jetzt = new Date().toISOString();\nconst zeilen = roh\n  .filter((k) => k && k.investorId)\n  .map((k) => {\n    const stufe = STUFEN.includes(k.status) ? k.status : 'vorgemerkt';\n    const z = {\n      mandat,\n      investor_id: String(k.investorId),\n      firma: k.firma ?? null,\n      ansprechpartner: k.ansprechpartner ?? null,\n      email: k.email ?? null,\n      status: stufe,\n      geaendert_durch: String(b.durch || 'cockpit'),\n      geaendert: jetzt,\n    };\n    if (k.notiz !== undefined) z.notiz = k.notiz;\n    if (k.letzterKontakt !== undefined) z.letzter_kontakt = k.letzterKontakt;\n    if (k.naechstesFollowUp !== undefined) z.naechstes_followup = k.naechstesFollowUp;\n    return z;\n  });\nif (zeilen.length === 0) throw new Error('Kontaktstand ohne Investor');\nreturn [{ json: { mandat, anzahl: zeilen.length, zeilen } }];\n"
      },
      "id": "kt-pruefen",
      "name": "Eingabe pruefen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        280
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.supabaseBasis }}/rest/v1/kontakt?on_conflict=mandat,investor_id",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates,return=representation"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.zeilen) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json",
              "fullResponse": true
            }
          }
        }
      },
      "id": "kt-schreiben",
      "name": "Kontaktstand schreiben",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        280
      ]
    },
    {
      "parameters": {
        "jsCode": "// Hat das Schreiben wirklich gegriffen? Null geaenderte Zeilen heisst: nichts\n// gespeichert - das muss das Cockpit erfahren und nicht stillschweigend\n// annehmen, es sei gut gegangen.\nconst r = $input.first()?.json ?? {};\nconst status = Number(r.statusCode ?? 0);\nconst zeilen = Array.isArray(r.body) ? r.body : [];\nconst ok = status >= 200 && status < 300;\nreturn [{ json: { ok: ok && zeilen.length > 0, gespeichert: ok ? zeilen.length : 0, status } }];\n"
      },
      "id": "kt-ergebnis",
      "name": "Ergebnis zusammenfassen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        280
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: $json.ok, gespeichert: $json.gespeichert }) }}",
        "options": {}
      },
      "id": "kt-schreib-antwort",
      "name": "Speichern bestaetigen",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1320,
        280
      ]
    },
