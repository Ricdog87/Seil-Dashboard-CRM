# SEIL Cockpit · Modul 02 – Anbindung Modul 01 (Datenraum-Agent auf n8n)
# Alle Werte sind serverseitig; nichts davon erreicht den Browser. Ohne MODUL01_STATUS_URL
# läuft das Cockpit unverändert mit Demodaten (Modus „demo“).

# Datenraum-Status-API der n8n-Instanz (Workflow 09), GET
MODUL01_STATUS_URL=https://N8N-BASIS-URL/webhook/seil/datenraum-status
# Gleicher Wert wie im Header-Auth-Credential von Workflow 09 (Header X-Seil-Secret) – nie ins Repository
MODUL01_SECRET=BITTE-SETZEN
# Zuordnung Cockpit-Objekt-ID → Kennung oder Name des Datenraums in Modul 01 (echte Kennungen nur hier)
MODUL01_OBJEKT_MAP={"o1":"MODUL01-KENNUNG-OBJEKT-1"}
# Zeitlimit für den Abruf in Millisekunden
MODUL01_TIMEOUT_MS=4000
